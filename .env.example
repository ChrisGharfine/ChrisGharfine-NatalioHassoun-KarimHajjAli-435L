# team-integration-v1.0.0 -- configuration template for Karim's services
# Copy to .env.local and fill in. NEVER commit a filled-in copy.

# --- Database -------------------------------------------------------------
# The shared integration database. Natalio's and Chris's migrations run
# before mine (section 3).
KARIM_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sirms_integration

# --- JWT (section 4.1) ----------------------------------------------------
# Must match the secret Natalio's Users service signs with. At least 32
# bytes, randomly generated. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KARIM_JWT_VERIFICATION_KEY=
KARIM_JWT_ISSUER=security-sprint1-users
KARIM_JWT_AUDIENCE=security-sprint1-services

# --- Upstream services (section 2) ----------------------------------------
# Complete base URLs INCLUDING any path prefix. Natalio's carry /api/...,
# Chris's and mine do not. Inside containers use service DNS names, not
# 127.0.0.1.
KARIM_USERS_URL=http://127.0.0.1:8001/api/natalio-hassoun
KARIM_ASSETS_URL=http://127.0.0.1:8002
KARIM_LOGS_URL=http://127.0.0.1:8005/api/natalio-hassoun
KARIM_NOTIFICATIONS_URL=http://127.0.0.1:8008
KARIM_HTTP_TIMEOUT_SECONDS=5

# --- My outbound service identities (section 4.2) -------------------------
# Three DISTINCT random keys, separate from the JWT secret and each other.
# Natalio registers the matching values in his SERVICE_TOKENS.
KARIM_INCIDENTS_SERVICE_KEY=
KARIM_VULNERABILITIES_SERVICE_KEY=
KARIM_NOTIFICATIONS_SERVICE_KEY=

# --- Inbound service keys I accept ----------------------------------------
# Who may call POST /internal/notifications, as name:key pairs.
# At minimum my own two triggers; add threats/users/playbooks when their
# owners define a trigger.
KARIM_SERVICE_TOKENS=incidents:,vulnerabilities:

# --- Ports ----------------------------------------------------------------
KARIM_INCIDENTS_PORT=8003
KARIM_VULNERABILITIES_PORT=8007
KARIM_NOTIFICATIONS_PORT=8008

# --- Delivery worker ------------------------------------------------------
KARIM_OUTBOX_BATCH_SIZE=50
KARIM_OUTBOX_MAX_BACKOFF_SECONDS=300
KARIM_WORKER_POLL_SECONDS=5
