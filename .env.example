# Copy to .env; replace every CHANGE_ME value. Do not commit .env.
DATABASE_URL=postgresql+psycopg://student1:CHANGE_ME@127.0.0.1:5432/security_incidents
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SERVICE_TOKENS={"users":"CHANGE_ME_USERS_SERVICE_KEY_32_CHARS","logs":"CHANGE_ME_LOGS_SERVICE_KEY_32_CHARS","playbooks":"CHANGE_ME_PLAYBOOKS_SERVICE_KEY_32_CHARS"}
API_PREFIX=/api/natalio-hassoun
USERS_URL=http://127.0.0.1:8001
LOGS_URL=http://127.0.0.1:8005
SERVICE_TIMEOUT=3
# Set for create-admin only. Not used as hardcoded defaults.
ADMIN_FULL_NAME=Natalio Hassoun
ADMIN_USERNAME=natalio.admin
ADMIN_EMAIL=CHANGE_ME@example.edu
ADMIN_PASSWORD=CHANGE_ME
ADMIN_DEPARTMENT=Security
# Set for seed-demo only. Use a strong password meeting the policy.
DEMO_PASSWORD=CHANGE_ME
# Dedicated EMPTY test database; never your development/team database.
TEST_DATABASE_URL=postgresql+psycopg://student1:CHANGE_ME@127.0.0.1:5432/security_incidents_test
