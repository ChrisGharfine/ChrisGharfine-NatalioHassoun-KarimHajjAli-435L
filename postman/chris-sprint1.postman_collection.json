        {
          "name": "Create asset",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{assets_base_url}}/assets",
            "description": "Chris Gharfine — Create an asset owned by an existing Users ID. Capture the actual ID for subsequent calls.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab Server\",\n  \"asset_type\": \"server\",\n  \"ip_address\": \"192.0.2.10\",\n  \"department\": \"Security\",\n  \"owner_id\": {{asset_owner_id}},\n  \"criticality\": \"high\",\n  \"operating_system\": \"Linux\",\n  \"location\": \"Lab 1\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Created record has an integer ID\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"asset_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
