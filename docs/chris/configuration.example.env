# Template only. Supply actual values locally; do not commit a populated copy.
# Python services read process environment. Compose can use an ignored --env-file.
CHRIS_DATABASE_URL=
CHRIS_JWT_VERIFICATION_KEY=
CHRIS_JWT_ALGORITHM=HS256
CHRIS_JWT_ISSUER=security-sprint1-users
CHRIS_JWT_AUDIENCE=security-sprint1-services
# Five distinct service keys, also registered by the team's actual providers.
# Asset runtime: assets + incidents + vulnerabilities; Threats: threats;
# Reports: reports; combined audit worker: assets + threats + reports.
CHRIS_SERVICE_TOKENS={"assets":"","threats":"","reports":"","incidents":"","vulnerabilities":""}
CHRIS_USERS_URL=http://127.0.0.1:8001/api/natalio-hassoun
CHRIS_ASSETS_URL=http://127.0.0.1:8002
CHRIS_INCIDENTS_URL=http://127.0.0.1:8003
CHRIS_THREATS_URL=http://127.0.0.1:8004
CHRIS_AUDIT_URL=http://127.0.0.1:8005/api/natalio-hassoun
CHRIS_VULNERABILITIES_URL=http://127.0.0.1:8007
CHRIS_LOGIN_SUCCESS_ACTION=login_success
CHRIS_LOGIN_FAILURE_ACTION=login_failed
